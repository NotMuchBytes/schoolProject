      "speaker_id": "l2_guide",
      "speaker_name_ar": "دليل المدينة",
      "text_ar": "اكتمل سجل الحياة: الحكم والعمل والمجتمع والمعتقدات والفنون والرياضة، ثم الآثار في الأردن.",
      "source_fact_ids": [],
      "content_type": "fictional_conclusion",
