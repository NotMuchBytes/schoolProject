      "speaker_id": "narrator",
      "speaker_name_ar": "الراوي",
      "text_ar": "لم تكن الحضارة حدوداً وحروباً وحدها؛ كانت حياة ناس ومدناً وأعمالاً وأفكاراً.",
      "source_fact_ids": [],
